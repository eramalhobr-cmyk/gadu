{
  "name": "gadu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-strip-types src/lib/*.test.ts src/lib/core/*.test.ts src/lib/finance/*.test.ts src/lib/goals/*.test.ts src/lib/3d/*.test.ts src/lib/telemetria/*.test.ts src/lib/agentes/*.test.ts src/lib/compras/*.test.ts src/lib/filhos/*.test.ts src/lib/voz/*.test.ts scripts/piloto-voz/*.test.mjs",
    "test:integration": "node --test --experimental-strip-types --experimental-test-module-mocks --import ./test/register-alias.mjs test/*.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "npm run test:e2e:public && npm run test:e2e:mobile && npm run test:e2e:auth",
    "test:e2e:public": "node --test --test-concurrency=1 e2e/public.e2e.cjs",
    "test:e2e:mobile": "node --test --test-concurrency=1 e2e/mobile.e2e.cjs",
    "test:e2e:auth": "node --test --test-concurrency=1 e2e/auth.e2e.cjs",
    "test:e2e:visual": "node --test --test-concurrency=1 e2e/visual.e2e.cjs",
    "e2e:browsers": "playwright install --with-deps chromium webkit",
    "audit:db": "GADU_AUDIT=1 bash scripts/test-db.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/oidc": "4.0.7",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/web-push": "3.6.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
