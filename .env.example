# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em Settings > Environment Variables.
# Nunca coloque chaves reais neste arquivo.

# Supabase (públicas: a segurança vem do RLS no banco)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Quem pode entrar (e-mails separados por vírgula). Vazio = ninguém entra.
ALLOWED_EMAILS=voce@gmail.com

# Motor principal (secreto, só no servidor)
ANTHROPIC_API_KEY=
# Modelo e esforço. Para gastar menos, use claude-haiku-5-5.
GADU_MODEL=claude-opus-5-5
GADU_EFFORT=low

# Contingência opcional: se o motor principal falhar, tenta o Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Proteção de custo: mensagens por pessoa por dia.
DAILY_MESSAGE_LIMIT=150
