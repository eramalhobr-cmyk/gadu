# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em Settings > Environment Variables.
# Nunca coloque chaves reais neste arquivo.

# Supabase (públicas: a segurança vem do RLS no banco)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Quem pode entrar (e-mails separados por vírgula). Vazio = ninguém entra.
ALLOWED_EMAILS=voce@gmail.com

# Motor: na Vercel, o AI Gateway autentica sozinho (token OIDC). Nada a configurar.
GATEWAY_MODEL=anthropic/claude-opus-5.5
GATEWAY_FALLBACK_MODEL=google/gemini-3.5-flash
# Modelo barato para tarefas de bastidor (resumo de conversa, importação de memórias)
CHEAP_MODEL=claude-haiku-5-5
GATEWAY_CHEAP_MODEL=anthropic/claude-haiku-5.5
# Fora da Vercel, use uma chave do AI Gateway ou da Anthropic (secretas, só no servidor).
AI_GATEWAY_API_KEY=

# Motor direto na Anthropic (opcional)
ANTHROPIC_API_KEY=
# Modelo e esforço. Para gastar menos, use claude-haiku-5-5.
GADU_MODEL=claude-opus-5-5
GADU_EFFORT=low

# Contingência opcional: se o motor principal falhar, tenta o Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Proteção de custo: mensagens por pessoa por dia.
DAILY_MESSAGE_LIMIT=150

# Fase 2 · Google (Agenda e Gmail, só leitura). Cliente OAuth "Aplicativo da Web" no Google Cloud.
# Endereço de retorno autorizado: https://SEU-DOMINIO/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64 (openssl rand -base64 32). Criptografa o token do Google no banco.
GOOGLE_TOKEN_KEY=
